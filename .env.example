# SealHour environment template. Copy to .env (gitignored) and fill in. Never commit .env.
# Placeholders only: no real key, RPC token or mnemonic belongs in this file.
# The Makefile does not load .env (except `make e2e-testnet`, which reads DEPLOYER_KEY): export the variables
# yourself, for example
#   set -a; . ./.env; set +a

# Chain. Unset = local Hardhat node (http://127.0.0.1:8545, what `make demo` uses).
# Set both RPC_URL and DEPLOYER_KEY to enable the baseSepolia network in contracts/hardhat.config.js:
#   cd contracts && BEACON_GENESIS=... BEACON_PERIOD=... npx hardhat run scripts/deploy.js --network baseSepolia
# Leave both empty for local work: a placeholder key would make every hardhat command fail validation.
RPC_URL=
# RPC_URL=https://sepolia.base.org
# Throwaway key of a Base Sepolia account funded with testnet ETH only. 0x followed by 64 hex characters.
DEPLOYER_KEY=
# DEPLOYER_KEY=0x<64 hex characters, testnet only>

# Time beacon relay (drand HTTP API).
# Default: the local drand compatible relay started by `make demo` (scripts/beacon-server.mjs).
BEACON_URL=http://127.0.0.1:8787
# Production option: the real drand quicknet relay (bls-unchained-g1-rfc9380, period 3 s).
# Used by hand, see README "Switching to drand quicknet and Base Sepolia" (not wired into the Makefile).
# BEACON_URL=https://api.drand.sh/52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971

# Seconds between seeding and the opening round in `make demo` (default 240; demo-cli default 20).
# Exported, it also applies to `make demo-cli`: keep it commented unless you need it.
# DEMO_OPEN_IN=240
