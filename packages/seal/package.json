{
  "name": "@sealhour/seal",
  "version": "0.1.0",
  "description": "SealHour cryptographic core: tlock + age double lock, draw, fingerprint, Merkle, base32, leak verifier",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "1.4.2",
    "@noble/hashes": "1.4.0",
    "age-encryption": "0.3.1",
    "ethers": "6.17.0",
    "tlock-js": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
